# Streamlit client secrets — COPY this file to `secrets.toml` and fill in real values.
# `secrets.toml` is gitignored; this `.example` file is committed as a template.
#
# After `cdk deploy`, fetch the real values:
#
#   API_BASE_URL: from CloudFormation outputs (ApiStack -> ApiUrl)
#   API_KEY:      aws secretsmanager get-secret-value \
#                   --secret-id <SecretArn from StorageStack output> \
#                   --query SecretString --output text \
#                 | jq -r .apiKey

API_BASE_URL = "https://abcd1234.execute-api.us-east-1.amazonaws.com/prod"
API_KEY      = "replace-me-with-value-from-secrets-manager"
