# Streamlit client secrets. Copy this file to `secrets.toml` and fill in real values.
# `secrets.toml` is gitignored; this `.example` file is committed as a template.
#
# After `cdk deploy` (Phase 8), populate these from CloudFormation outputs and
# Secrets Manager. None of the OAuth values can be derived at runtime.

[auth]
# Where Cognito Hosted UI redirects after a successful login. Must match the
# callback URL registered on the Cognito App Client exactly.
redirect_uri = "http://localhost:8501/oauth2callback"

# 32+ random bytes used to sign Streamlit's identity cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "replace-me-32-bytes-random-hex"

# Cognito App Client id (CDK output: ApiStack.UserPoolClientId).
client_id = "replace-me-cognito-app-client-id"

# Cognito App Client secret. Fetch once after `cdk deploy`:
#   aws secretsmanager get-secret-value \
#     --secret-id <UserPoolClientSecretArn from cdk-outputs.json> \
#     --query SecretString --output text
client_secret = "replace-me-cognito-app-client-secret"

# OIDC discovery document for the Cognito User Pool. Substitute <USER_POOL_ID>
# (CDK output: ApiStack.UserPoolId).
server_metadata_url = "https://cognito-idp.us-east-1.amazonaws.com/<USER_POOL_ID>/.well-known/openid-configuration"

# Surface the ID token to the Python process so we can forward it as a Bearer
# token to API Gateway. `access` is exposed for parity but unused today.
expose_tokens = ["id", "access"]


[api]
# API Gateway base URL (CDK output: ApiStack.ApiUrl). Trailing slash is fine;
# the client strips it.
api_base_url = "https://abcd1234.execute-api.us-east-1.amazonaws.com/prod"


[runtime]
# AgentCore Runtime base URL if the client ever needs to call it directly.
# Today all calls go through API Gateway -> Lambda proxy; this is reserved.
api_base_url = "https://abcd1234.execute-api.us-east-1.amazonaws.com/prod"


[stream]
# Phase 9a — Lambda Function URL for the streaming /query-stream endpoint.
# CDK output: ApiStack.StreamFunctionUrl. The Function URL ends with a slash;
# the client POSTs to <stream_url>query-stream.
# Example: https://abcd1234abcd.lambda-url.us-east-1.on.aws/
stream_url = "https://replace-me-function-url.lambda-url.us-east-1.on.aws/"
